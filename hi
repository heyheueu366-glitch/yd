            end
        end
    end
end)

-- منصة الطيران/الارتفاع (ثابتة - ترفع وتوقف / تنزل وتوقف)
local isPlatformActive = false
local floorPart = nil
local renderConnection = nil
local platformY = 0
local heightStep = 4
local baseLift = 6
local liftCount = 0  -- عدد مرات الرفع

local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function createPlatform(y)
    if floorPart and floorPart.Parent then
        pcall(function() floorPart:Destroy() end)
    end
    floorPart = Instance.new("Part")
    floorPart.Name = "RFX_FloorPart"
    floorPart.Size = Vector3.new(12, 1, 12)
    floorPart.Anchored = true
    floorPart.CanCollide = true
    floorPart.Transparency = 1
    floorPart.Parent = Workspace

    local hrp = getHRP()
    local x = hrp and hrp.Position.X or 0
    local z = hrp and hrp.Position.Z or 0
    floorPart.CFrame = CFrame.new(x, y - 3.2, z)
end

local function removePlatform()
    isPlatformActive = false
    platformY = 0
    liftCount = 0
    if floorPart then
        pcall(function() floorPart:Destroy() end)
        floorPart = nil
    end
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end
end

-- المنصة تتبع X/Z فقط، الـ Y ثابت (ما يسحب اللاعب)
local function updatePlatformPosition()
    if not isPlatformActive or not floorPart or not floorPart.Parent then return end
    local hrp = getHRP()
    if not hrp then return end

    floorPart.CFrame = CFrame.new(hrp.Position.X, platformY - 3.2, hrp.Position.Z)

    -- منع السقوط/السحب العمودي
    local vel = hrp.AssemblyLinearVelocity
    if math.abs(vel.Y) > 1.5 then
        hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
    end
end

local function setPlayerHeight(newY)
    local hrp = getHRP()
    if not hrp then return end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(hrp.Position.X, newY, hrp.Position.Z)
    platformY = newY

    if floorPart and floorPart.Parent then
        floorPart.CFrame = CFrame.new(hrp.Position.X, newY - 3.2, hrp.Position.Z)
    end
end

UpBtn.MouseButton1Click:Connect(function()
    local hrp = getHRP()
    if not hrp then return end

    if not isPlatformActive then
        isPlatformActive = true
        liftCount = 1
        local newY = hrp.Position.Y + baseLift
        createPlatform(newY)
        setPlayerHeight(newY)
        if not renderConnection then
            renderConnection = RunService.Heartbeat:Connect(updatePlatformPosition)
        end
    else
        liftCount = liftCount + 1
        setPlayerHeight(platformY + heightStep)
    end
end)

DownBtn.MouseButton1Click:Connect(function()
    if not isPlatformActive then return end

    local hrp = getHRP()
    if not hrp then return end

    liftCount = liftCount - 1

    if liftCount <= 0 then
        -- رجع للأرض وشيل المنصة
        removePlatform()
        hrp.AssemblyLinearVelocity = Vector3.zero
        return
    end

    -- نزل خطوة واحدة ووقف
    setPlayerHeight(platformY - heightStep)
end)

LocalPlayer.CharacterAdded:Connect(function()
    if isPlatformActive then
        removePlatform()
    end
end)

local function setAntiHitState(enabled)
    antiHitEnabled = enabled

    if antiHitEnabled then
        ToggleAntiHitBtn.BackgroundColor3 = Color3.fromRGB(30, 140, 80)
        AntiHitText.Text = "ANTI HIT - ON"
        ToggleStroke.Color = Color3.fromRGB(60, 200, 120)

        for _, descendant in ipairs(Workspace:GetDescendants()) do
            setupPrompt(descendant)
        end

        if #eventConnections == 0 then
            table.insert(eventConnections, Workspace.DescendantAdded:Connect(function(descendant)
                if antiHitEnabled then setupPrompt(descendant) end
            end))
            
            table.insert(eventConnections, ProximityPromptService.PromptShown:Connect(function(prompt)
                if antiHitEnabled then setupPrompt(prompt) end
            end))
            
            table.insert(eventConnections, ProximityPromptService.PromptTriggered:Connect(function(_, player)
                if antiHitEnabled and player == LocalPlayer then
                    executeAntiHitBypass()
                end
            end))
        end
    else
        ToggleAntiHitBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        AntiHitText.Text = "ANTI HIT - OFF"
        ToggleStroke.Color = Color3.fromRGB(220, 80, 80)

        for _, conn in ipairs(eventConnections) do
            if conn then conn:Disconnect() end
        end
        eventConnections = {}
    end
end

ToggleAntiHitBtn.MouseButton1Click:Connect(function()
    setAntiHitState(not antiHitEnabled)
end)

